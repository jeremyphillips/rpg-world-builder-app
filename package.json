{
  "name": "rpg-world-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n proxy,apps -c blue,green \"pnpm dev:proxy\" \"turbo run dev\"",
    "dev:proxy": "node tools/proxy/dev-proxy.mjs",
    "build": "turbo run build --filter='!@rpg/bench'",
    "build:bench": "turbo run build --filter='@rpg/bench'",
    "build:ci": "turbo run build --filter='...[origin/main]' --filter='!@rpg/bench'",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --filter='...[HEAD]'",
    "lint:ci": "turbo run lint --filter='...[origin/main]'",
    "test": "turbo run test",
    "test:affected": "turbo run test --filter='...[HEAD]'",
    "coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:affected": "turbo run typecheck --filter='...[HEAD]'",
    "typecheck:ci": "turbo run typecheck --filter='...[origin/main]'",
    "gate:ci:quality": "turbo run typecheck lint --filter='...[origin/main]'",
    "gate:fallow-dupes": "fallow dupes --production --format human",
    "gate:fallow-health": "bash tools/hooks/fallow-health-gate.sh",
    "gate:fallow-health:coverage": "bash tools/hooks/fallow-health-gate.sh --coverage ./coverage/coverage-final.json",
    "gate:pre-push": "pnpm coverage && pnpm gate:fallow-health:coverage && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "fallow --format human || true",
    "bench": "pnpm --filter @rpg/bench-cli bench",
    "vocab:audit": "pnpm --filter @rpg/term-audit run audit",
    "catalog:spell-modeling-audit": "pnpm exec tsx packages/catalog/scripts/spell-modeling-audit.mjs",
    "catalog:spell-modeling-report": "pnpm exec tsx packages/catalog/scripts/generate-spell-modeling-report.mjs",
    "generate:json-schemas": "pnpm --filter @rpg/contracts generate:json-schemas",
    "gate:json-schemas": "pnpm generate:json-schemas && (git diff --exit-code packages/contracts/generated && test -z \"$(git status --porcelain packages/contracts/generated)\") || (echo '::error::Committed JSON schemas are stale. Run pnpm generate:json-schemas and commit packages/contracts/generated.' >&2 && git diff --stat packages/contracts/generated >&2 && exit 1)",
    "storybook": "concurrently -n ui,dash -c cyan,magenta \"pnpm storybook:ui\" \"pnpm storybook:dashboard\"",
    "storybook:ui": "pnpm --filter @rpg/ui storybook",
    "storybook:dashboard": "pnpm --filter @rpg/dashboard storybook",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@rpg/config": "workspace:*",
    "concurrently": "^10.0.3",
    "fallow": "^2.89.0",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8"
  }
}
