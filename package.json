{
  "name": "rpg-world-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n proxy,apps -c blue,green \"pnpm dev:proxy\" \"turbo run dev\"",
    "dev:proxy": "node tools/proxy/dev-proxy.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "fallow --format human || true",
    "storybook": "concurrently -n ui,dash -c cyan,magenta \"pnpm storybook:ui\" \"pnpm storybook:dashboard\"",
    "storybook:ui": "pnpm --filter @rpg/ui storybook",
    "storybook:dashboard": "pnpm --filter @rpg/dashboard storybook",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@rpg/config": "workspace:*",
    "concurrently": "^10.0.3",
    "fallow": "^2.89.0",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16"
  }
}
