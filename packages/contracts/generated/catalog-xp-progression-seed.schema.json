{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "minItems": 1,
  "maxItems": 1,
  "type": "array",
  "items": {
    "$ref": "#/definitions/__schema0"
  },
  "definitions": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "rulesetId": {
          "type": "string",
          "enum": ["srd-cc-5.2.1"],
          "description": "srd-cc-5.2.1"
        },
        "source": {
          "type": "string",
          "enum": ["system", "homebrew"],
          "description": "system | homebrew"
        },
        "campaignId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "imageKey": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "standard",
                  "description": "standard"
                }
              },
              "required": ["kind"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "class",
                  "description": "class"
                },
                "classId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["kind", "classId"],
              "additionalProperties": false
            }
          ]
        },
        "entries": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema1"
          }
        }
      },
      "required": [
        "id",
        "slug",
        "rulesetId",
        "source",
        "campaignId",
        "createdAt",
        "updatedAt",
        "name",
        "scope",
        "entries"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "xpRequired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["level", "xpRequired"],
      "additionalProperties": false
    }
  }
}
