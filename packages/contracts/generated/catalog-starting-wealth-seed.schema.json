{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "minItems": 1,
  "maxItems": 1,
  "type": "array",
  "items": {
    "$ref": "#/definitions/__schema0"
  },
  "definitions": {
    "__schema0": {
      "type": "object",
      "properties": {
        "imageKey": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "standard",
                  "description": "standard"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "tiers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema1"
          }
        }
      },
      "required": [
        "name",
        "scope",
        "tiers"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "minLevel": {
          "$ref": "#/definitions/__schema2"
        },
        "maxLevel": {
          "$ref": "#/definitions/__schema2"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "includeNormalStartingEquipment": {
          "default": true,
          "type": "boolean"
        },
        "bonusGold": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "baseGp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "formula": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "dice"
                      ],
                      "description": "dice"
                    },
                    "dice": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "faces": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 4
                            },
                            {
                              "type": "number",
                              "const": 6
                            },
                            {
                              "type": "number",
                              "const": 8
                            },
                            {
                              "type": "number",
                              "const": 10
                            },
                            {
                              "type": "number",
                              "const": 12
                            },
                            {
                              "type": "number",
                              "const": 20
                            },
                            {
                              "type": "number",
                              "const": 100
                            }
                          ]
                        }
                      },
                      "required": [
                        "count",
                        "faces"
                      ],
                      "additionalProperties": false
                    },
                    "multiplier": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "cp",
                        "sp",
                        "gp",
                        "pp"
                      ],
                      "description": "cp | sp | gp | pp"
                    }
                  },
                  "required": [
                    "kind",
                    "dice",
                    "multiplier",
                    "currency"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "baseGp",
                "formula"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "magicItemGrants": {
          "default": [],
          "allOf": [
            {
              "$ref": "#/definitions/__schema3"
            }
          ]
        }
      },
      "required": [
        "minLevel",
        "maxLevel",
        "id",
        "label",
        "includeNormalStartingEquipment",
        "magicItemGrants"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "__schema3": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "very_rare",
              "legendary",
              "artifact"
            ],
            "description": "common | uncommon | rare | very_rare | legendary | artifact"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "rarity",
          "quantity"
        ],
        "additionalProperties": false
      }
    }
  }
}
