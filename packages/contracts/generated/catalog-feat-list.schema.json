{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "rulesetId": {
        "type": "string",
        "enum": ["srd-cc-5.2.1"],
        "description": "srd-cc-5.2.1"
      },
      "source": {
        "type": "string",
        "enum": ["system", "homebrew"],
        "description": "system | homebrew"
      },
      "campaignId": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "imageKey": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": ["origin", "general", "fighting-style", "epic-boon"],
        "description": "origin | general | fighting-style | epic-boon"
      },
      "prerequisite": {
        "allOf": [
          {
            "$ref": "#/definitions/__schema0"
          }
        ]
      },
      "repeatable": {
        "default": {
          "allowed": false
        },
        "type": "object",
        "properties": {
          "allowed": {
            "$ref": "#/definitions/__schema1"
          },
          "notes": {
            "$ref": "#/definitions/__schema2"
          }
        },
        "required": ["allowed"],
        "additionalProperties": false
      },
      "benefit": {
        "type": "object",
        "properties": {
          "sections": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/definitions/__schema3"
            }
          }
        },
        "required": ["sections"],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "slug",
      "rulesetId",
      "source",
      "campaignId",
      "createdAt",
      "updatedAt",
      "name",
      "category",
      "repeatable"
    ],
    "additionalProperties": false
  },
  "definitions": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all",
              "description": "all"
            },
            "requirements": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema0"
              }
            }
          },
          "required": ["kind", "requirements"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "any",
              "description": "any"
            },
            "requirements": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema0"
              }
            }
          },
          "required": ["kind", "requirements"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "minLevel",
              "description": "minLevel"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["kind", "level"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "abilityMinimum",
              "description": "abilityMinimum"
            },
            "ability": {
              "type": "string",
              "enum": ["str", "dex", "con", "int", "wis", "cha"],
              "description": "str | dex | con | int | wis | cha"
            },
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": ["kind", "ability", "minimum"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "classLevel",
              "description": "classLevel"
            },
            "classSlug": {
              "type": "string",
              "minLength": 1
            },
            "minimum": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "classSlug", "minimum"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "feature",
              "description": "feature"
            },
            "featureId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "featureId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spellcasting",
              "description": "spellcasting"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "__schema1": {
      "type": "boolean"
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    }
  }
}
