{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      },
      "label": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "enum": [
          "standard",
          "rare"
        ],
        "description": "standard | rare"
      }
    },
    "required": [
      "id",
      "label",
      "description",
      "category"
    ],
    "additionalProperties": false
  }
}
