                        "heroic",
                        "dark_fantasy",
                        "gritty",
                        "horror",
                        "humorous",
                        "weird",
                        "epic",
                        "hopeful"
                      ],
                      "description": "heroic | dark_fantasy | gritty | horror | humorous | weird | epic | hopeful"
                    }
