                            {
                              "type": "number",
                              "const": 6
                            },
                            {
                              "type": "number",
                              "const": 8
                            },
                            {
                              "type": "number",
                              "const": 10
                            },
                            {
                              "type": "number",
                              "const": 12
                            },
                            {
                              "type": "number",
                              "const": 20
                            },
                            {
                              "type": "number",
                              "const": 100
                            }
                          ]
