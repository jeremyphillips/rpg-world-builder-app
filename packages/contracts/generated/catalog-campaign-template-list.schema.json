                        "dungeon_crawl",
                        "urban_adventure",
                        "political_intrigue",
                        "exploration",
                        "survival",
                        "mystery",
                        "sandbox",
                        "tactical_combat",
                        "roleplay_driven"
                      ],
                      "description": "dungeon_crawl | urban_adventure | political_intrigue | exploration | survival | mystery | sandbox | tactical_combat | roleplay_driven"
                    }
