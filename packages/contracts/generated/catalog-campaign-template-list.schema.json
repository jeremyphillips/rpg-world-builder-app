                      "required": [
                        "count",
                        "faces"
                      ],
                      "additionalProperties": false
                    },
                    "multiplier": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "cp",
                        "sp",
                        "gp",
                        "pp"
                      ],
                      "description": "cp | sp | gp | pp"
                    }
                  },
                  "required": [
                    "kind",
                    "dice",
                    "multiplier",
                    "currency"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "baseGp",
                "formula"
              ],
              "additionalProperties": false
