      "type": "string",
      "enum": [
        "standard",
        "rare"
      ],
      "description": "standard | rare"
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
