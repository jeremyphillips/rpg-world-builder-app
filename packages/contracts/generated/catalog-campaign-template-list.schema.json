          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "name",
          "id",
          "slug",
          "version"
        ],
        "additionalProperties": false
      },
      "rulesetId": {
        "type": "string",
        "enum": [
          "srd-cc-5.2.1"
        ],
        "description": "srd-cc-5.2.1"
      },
      "defaults": {
