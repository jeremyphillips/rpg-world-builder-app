{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "metadata": {
        "type": "object",
        "properties": {
          "imageKey": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": [
          "name",
          "id",
          "slug",
          "version"
        ],
        "additionalProperties": false
      },
      "rulesetId": {
        "type": "string",
        "enum": [
          "srd-cc-5.2.1"
        ],
        "description": "srd-cc-5.2.1"
      }
    },
    "required": [
      "metadata",
      "rulesetId"
    ],
    "additionalProperties": false
  }
}
