{
  "name": "@rpg/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./species": {
      "types": "./src/species/index.ts",
      "default": "./src/species/index.ts"
    },
    "./equipment": {
      "types": "./src/equipment/index.ts",
      "default": "./src/equipment/index.ts"
    },
    "./classes": {
      "types": "./src/classes/index.ts",
      "default": "./src/classes/index.ts"
    },
    "./skill-proficiencies": {
      "types": "./src/skill-proficiencies/index.ts",
      "default": "./src/skill-proficiencies/index.ts"
    },
    "./spells": {
      "types": "./src/spells/index.ts",
      "default": "./src/spells/index.ts"
    },
    "./feats": {
      "types": "./src/feats/index.ts",
      "default": "./src/feats/index.ts"
    },
    "./xp-progressions": {
      "types": "./src/xp-progressions/index.ts",
      "default": "./src/xp-progressions/index.ts"
    },
    "./starting-wealth": {
      "types": "./src/starting-wealth/index.ts",
      "default": "./src/starting-wealth/index.ts"
    },
    "./starting-wealth/test-fixtures": {
      "types": "./src/starting-wealth/test-fixtures.ts",
      "default": "./src/starting-wealth/test-fixtures.ts"
    },
    "./vocabulary": {
      "types": "./src/vocabulary/index.ts",
      "default": "./src/vocabulary/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "spell-modeling-audit": "tsx scripts/spell-modeling-audit.mjs",
    "spell-modeling-report": "tsx scripts/generate-spell-modeling-report.mjs"
  },
  "dependencies": {
    "@rpg/contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rpg/config": "workspace:*",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
