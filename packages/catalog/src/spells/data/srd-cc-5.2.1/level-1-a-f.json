    "name": "Detect Evil and Good",
    "level": 1,
    "description": "<p>For the duration, you sense the location of any Aberration, Celestial, Elemental, Fey, Fiend, or Undead within 30 feet of yourself. You also sense whether the <em>Hallow</em> spell is active there and, if so, where.</p><p>The spell is blocked by 1 foot of stone, dirt, or wood; 1 inch of metal; or a thin sheet of lead.</p>",
    "school": "divination",
    "classIds": ["cleric", "paladin"],
    "tags": {
      "roles": ["detection"]
    },
    "castingTime": {
      "normal": {
        "value": 1,
        "unit": "action"
      },
