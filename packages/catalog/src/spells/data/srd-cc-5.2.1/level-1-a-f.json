    "name": "Bless",
    "description": "<p>You bless up to three creatures within range. Whenever a target makes an attack roll or a saving throw before the spell ends, the target adds 1d4 to the attack roll or save.</p>",
    "school": "enchantment",
    "level": 1,
    "classIds": ["cleric", "paladin"],
    "tags": {
