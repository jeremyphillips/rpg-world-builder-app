    "name": "Hunter's Mark",
    "level": 1,
    "description": "<p>You magically mark one creature you can see within range as your quarry. Until the spell ends, you deal an extra 1d6 Force damage to the target whenever you hit it with an attack roll. You also have Advantage on any Wisdom (Perception or Survival) check you make to find it.</p><p>If the target drops to 0 Hit Points before this spell ends, you can take a Bonus Action to move the mark to a new creature you can see within range.</p>",
    "school": "divination",
    "classIds": ["ranger"],
    "tags": {
      "damageTypes": ["force"],
      "roles": ["buff", "damage"]
    },
    "castingTime": {
      "normal": {
        "value": 1,
        "unit": "bonus-action"
      },
      "canBeCastAsRitual": false
    },
    "range": {
