      "value": {
        "value": 90,
        "unit": "ft"
      }
    },
    "duration": {
      "kind": "timed",
      "value": 1,
      "unit": "hour",
      "concentration": true,
      "upTo": true
    },
    "components": {
      "verbal": true
    },
    "higherLevelSlotEffect": "<p>Your Concentration can last longer with a spell slot of level 3–4 (up to 8 hours) or 5+ (up to 24 hours).</p>",
