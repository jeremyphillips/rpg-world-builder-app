# Express API configuration. Copy to .env for local development.

# Server
NODE_ENV=development
PORT=5001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/rpg

# Session JWT signing secret (REQUIRED in production; min 16 chars).
# A dev fallback is used outside production if this is unset.
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime (any vercel/ms-style duration, e.g. 7d, 12h, 30m).
JWT_EXPIRES_IN=7d

# File uploads
# Directory where uploaded files are stored (relative to apps/api/ CWD).
UPLOAD_DIR=./uploads
# Maximum upload size in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# Dev Bench API (`/api/bench/*`). Defaults to enabled in development/test and
# disabled in production. Set explicitly when deploying with bench support.
# DEV_BENCH_ENABLED=true

# Experimental D&D Beyond character import (`/api/character-import/*`). Defaults to
# enabled in development/test and disabled in production.
# CHARACTER_IMPORT_ENABLED=true
# DND_BEYOND_FETCH_TIMEOUT_MS=10000
