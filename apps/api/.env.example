# Express API configuration. Copy to .env for local development.

# Server
NODE_ENV=development
PORT=5001

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/rpg

# Session JWT signing secret (REQUIRED in production; min 16 chars).
# A dev fallback is used outside production if this is unset.
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime (any vercel/ms-style duration, e.g. 7d, 12h, 30m).
JWT_EXPIRES_IN=7d
